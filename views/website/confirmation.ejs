<div class="container py-5 text-center" style="max-width:560px">
  <i class="bi bi-<%= e.status === 'waitlisted' ? 'hourglass-split text-warning' : 'check-circle text-success' %> display-4"></i>
  <h1 class="h3 mt-2"><%= e.status === 'waitlisted' ? "You're on the waitlist" : 'Registration received' %></h1>
  <p class="mb-1"><strong><%= e.title %></strong></p><p class="text-muted"><%= f.dateTime(e.starts_at) %><%= e.location ? ' · ' + e.location : '' %></p>
  <p>Your registration number is <strong><%= e.reg_number %></strong>. Keep it for your records.</p>
  <div class="alert alert-info small">This is a demo: no confirmation email was sent and no payment was taken.</div>
  <a class="btn btn-primary" href="/classes">Back to classes</a>
</div>

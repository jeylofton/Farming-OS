<form method="post" action="<%= isNew ? '/admin/' + def.path : '/admin/' + def.path + '/' + record.id %>" <%- def.hasImage ? 'enctype="multipart/form-data"' : '' %> class="card card-body form-card" novalidate>
  <% if (def.hint && !isNew) { %><div class="alert alert-light border small"><i class="bi bi-info-circle me-1"></i><%= def.hint %></div><% } %>
  <div class="row g-3">
    <% def.fields.filter(x => !x.hidden).forEach(fld => { %><%- include('../../partials/field', { f: fld, record, refs, old, locked: !isNew && fld.lockOnEdit }) %><% }) %>
    <div class="col-12 d-flex flex-wrap gap-2"><button class="btn btn-primary">Save <%= def.singular.toLowerCase() %></button><a class="btn btn-outline-secondary" href="<%= back %>">Cancel</a></div>
  </div>
</form>
<% if (!isNew) { %>
<div class="d-flex flex-wrap gap-2 mt-3 no-print">
  <% if (def.archivable) { %><form method="post" action="/admin/<%= def.path %>/<%= record.id %>/archive" class="m-0"><input type="hidden" name="restore" value="<%= record.archived ? 1 : 0 %>"><button class="btn btn-outline-secondary"><i class="bi bi-archive me-1"></i><%= record.archived ? 'Restore' : 'Archive' %></button></form><% } %>
  <form method="post" action="/admin/<%= def.path %>/<%= record.id %>/delete" class="m-0" data-confirm="Permanently delete this <%= def.singular.toLowerCase() %>? This cannot be undone."><button class="btn btn-outline-danger"><i class="bi bi-trash me-1"></i>Delete</button></form>
</div>
<% } %>

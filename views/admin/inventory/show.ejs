<div class="row g-3">
  <div class="col-lg-5">
    <div class="card mb-3"><div class="card-body"><div class="fs-3 fw-bold"><%= f.qty(lot.quantity_available) %> <small class="fs-6 text-muted"><%= lot.unit %> available</small></div>
      <div class="text-muted"><%= lot.crop_name %><%= lot.variety ? ' – ' + lot.variety : '' %> · harvested <%= f.date(lot.harvested_on) %> · grade <%= lot.grade || '-' %></div></div></div>
    <form method="post" action="/admin/inventory/<%= lot.id %>/listing" class="card mb-3"><div class="card-header fw-semibold">Price & public listing</div><div class="card-body">
      <label class="form-label" for="up">Price per <%= lot.unit %></label><input class="form-control mb-2" id="up" type="number" step="0.01" min="0" name="unit_price" value="<%= lot.unit_price %>" required>
      <div class="form-check form-switch mb-3"><input class="form-check-input" type="checkbox" role="switch" id="listed" name="listed" value="1" <%= lot.listed ? 'checked' : '' %>><label class="form-check-label" for="listed">Show as available on the public produce page</label></div>
      <button class="btn btn-sm btn-outline-primary">Save</button></div></form>
    <form method="post" action="/admin/inventory/<%= lot.id %>/adjust" class="card"><div class="card-header fw-semibold">Adjust stock</div><div class="card-body">
      <label class="form-label" for="reason">Reason</label><select class="form-select mb-2" id="reason" name="reason"><% Object.entries(reasons).forEach(([k, label]) => { %><option value="<%= k %>"><%= label %></option><% }) %></select>
      <label class="form-label" for="quantity">Quantity (<%= lot.unit %>)</label><input class="form-control mb-1" id="quantity" type="number" step="any" name="quantity" required><div class="form-text mb-2">Use a negative number only for a count correction that removes stock.</div>
      <label class="form-label" for="note">Note</label><input class="form-control mb-3" id="note" name="note" maxlength="300">
      <button class="btn btn-sm btn-primary">Apply adjustment</button></div></form>
  </div>
  <div class="col-lg-7"><div class="card"><div class="card-header fw-semibold">Adjustment history</div>
    <div class="table-responsive"><table class="table table-sm mb-0 align-middle"><thead><tr><th>When</th><th>Reason</th><th class="text-end">Change</th><th>Note</th></tr></thead><tbody>
    <% lot.history.forEach(h => { %><tr><td class="text-nowrap"><%= f.dateTime(h.created_at) %></td><td class="text-capitalize"><%= h.reason %></td><td class="text-end <%= h.delta < 0 ? 'text-danger' : 'text-success' %>"><%= h.delta > 0 ? '+' : '' %><%= f.qty(h.delta) %></td><td class="break-any"><%= h.note || '' %></td></tr><% }) %></tbody></table></div></div></div>
</div>

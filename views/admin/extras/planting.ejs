<% const pct = row.expected_yield > 0 ? Math.min(100, Math.round(row.actual_yield / row.expected_yield * 100)) : 0; %>
<div class="card mb-3"><div class="card-body">
  <div class="d-flex justify-content-between flex-wrap gap-2 mb-2"><span><%- badge('stage', row.stage) %> <span class="ms-1"><%= row.crop_name %><%= row.crop_variety ? ' – ' + row.crop_variety : '' %></span></span><span class="text-muted"><%= row.plot_name || 'No bed assigned' %></span></div>
  <div class="small text-muted mb-1">Yield: <%= f.qty(row.actual_yield) %> of <%= row.expected_yield == null ? '?' : f.qty(row.expected_yield) %> <%= row.yield_unit %> estimated (<%= pct %>%)</div>
  <div class="progress" style="height:.7rem"><div class="progress-bar bg-success" role="progressbar" style="width:<%= pct %>%" aria-valuenow="<%= pct %>" aria-valuemin="0" aria-valuemax="100"></div></div>
  <% if (row.observations) { %><div class="mt-3 pre-line break-any"><strong>Observations:</strong> <%= row.observations %></div><% } %>
</div></div>
<div class="card mb-3"><div class="card-header d-flex justify-content-between align-items-center"><span class="fw-semibold">Tasks</span><a class="btn btn-sm btn-outline-primary" href="/admin/tasks/new?batch_id=<%= row.id %>">Add</a></div>
<% if (!extra.tasks.length) { %><div class="card-body text-muted">No tasks scheduled.</div><% } else { %>
<ul class="list-group list-group-flush"><% extra.tasks.forEach(t => { %><li class="list-group-item d-flex justify-content-between align-items-center gap-2">
  <form method="post" action="/admin/tasks/<%= t.id %>/toggle" class="m-0 d-flex align-items-center gap-2 min-w-0"><input type="hidden" name="back" value="<%= currentUrl %>"><button class="btn btn-sm p-0 border-0" aria-label="Toggle done"><i class="bi bi-<%= t.done ? 'check-circle-fill text-success' : 'circle' %> fs-5"></i></button>
    <a class="<%= t.done ? 'text-muted text-decoration-line-through' : '' %> text-break" href="/admin/tasks/<%= t.id %>/edit"><%= t.title %></a></form>
  <small class="text-muted text-nowrap"><%= f.date(t.due_date) %></small></li><% }) %></ul><% } %></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center"><span class="fw-semibold">Harvests</span><a class="btn btn-sm btn-outline-success" href="/admin/harvests/new?batch_id=<%= row.id %>">Record harvest</a></div>
<% if (!extra.harvests.length) { %><div class="card-body text-muted">Nothing harvested yet.</div><% } else { %>
<ul class="list-group list-group-flush"><% extra.harvests.forEach(h => { %><li class="list-group-item d-flex justify-content-between"><a href="/admin/harvests/<%= h.id %>/edit"><%= f.date(h.harvested_on) %></a><span><%= f.qty(h.quantity) %> <%= h.unit %> <span class="text-muted">grade <%= h.grade %></span></span></li><% }) %></ul><% } %></div>

<% if (pages > 1) {
  const qs0 = Object.assign({}, query); delete qs0.page;
  const qs = new URLSearchParams(qs0).toString();
  const href = (p) => base + '?' + (qs ? qs + '&' : '') + 'page=' + p; %>
<nav aria-label="Pages"><ul class="pagination pagination-sm justify-content-center flex-wrap mb-0">
  <li class="page-item <%= page <= 1 ? 'disabled' : '' %>"><a class="page-link" href="<%= href(page - 1) %>">Prev</a></li>
  <% for (let p = 1; p <= pages; p++) { if (p === 1 || p === pages || Math.abs(p - page) <= 2) { %>
    <li class="page-item <%= p === page ? 'active' : '' %>"><a class="page-link" href="<%= href(p) %>"><%= p %></a></li>
  <% } else if (Math.abs(p - page) === 3) { %><li class="page-item disabled"><span class="page-link">…</span></li><% } } %>
  <li class="page-item <%= page >= pages ? 'disabled' : '' %>"><a class="page-link" href="<%= href(page + 1) %>">Next</a></li>
</ul></nav>
<% } %>

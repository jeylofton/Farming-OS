PORT=3000
NODE_ENV=development
# Persistent paths on Hostinger (point at a writable folder that survives deploys)
# DEMO_DB_PATH=/home/user/persistent/demo.db
# UPLOAD_PATH=/home/user/persistent/uploads
SESSION_SECRET=change-me
DEMO_USER=admin
DEMO_PASS=demo1234
# Stage 1 only supports sqlite. Stage 2 adds "supabase".
DB_PROVIDER=sqlite
# Farm time zone
TZ=America/Atlanta
# Feature flags (override config/features.js). Disabled modules stay dormant, not deleted.
# FEATURE_LIVESTOCK=true

# ---- Online payments. With NO Stripe key the site uses a simulated DEMO checkout (no real money, nothing to set). ----
# DEMO_PAYMENTS=false   # turn the demo checkout off entirely
# Use TEST keys (sk_test_...) until the owner approves going live. Test cards: 4242 4242 4242 4242.
# STRIPE_SECRET_KEY=sk_test_...
# From Stripe Dashboard -> Developers -> Webhooks -> endpoint https://YOUR-SITE/webhooks/stripe
#   events: checkout.session.completed, checkout.session.expired, checkout.session.async_payment_succeeded, checkout.session.async_payment_failed
# STRIPE_WEBHOOK_SECRET=whsec_...
# Public address of the site (only needed if the server cannot work it out from the request)
# APP_URL=https://your-site.hostingersite.com
